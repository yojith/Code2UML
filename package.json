{
  "name": "python2uml",
  "displayName": "Python2UML",
  "description": "",
  "version": "0.1.0",
  "publisher": "yojith",
  "repository": {
    "type": "git",
    "url": "https://github.com/yojith/python2uml"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "python2uml",
          "title": "Python2UML",
          "icon": "media/python2uml.svg"
        }
      ]
    },
    "views": {
      "python2uml": [
        {
          "id": "python2uml.actions",
          "name": "Actions"
        }
      ]
    },
    "commands": [
      {
        "command": "python2uml.generatePython",
        "title": "Generate UML for Python"
      },
      {
        "command": "python2uml.generateJava",
        "title": "Generate UML for Java"
      },
      {
        "command": "python2uml.generateCpp",
        "title": "Generate UML for C++"
      },
      {
        "command": "python2uml.generateC",
        "title": "Generate UML for C"
      }
    ],
    "submenus": [
      {
        "id": "python2uml.generate",
        "label": "Generate UML for..."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "python2uml.generate",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ],
      "python2uml.generate": [
        {
          "command": "python2uml.generatePython"
        },
        {
          "command": "python2uml.generateJava"
        },
        {
          "command": "python2uml.generateCpp"
        },
        {
          "command": "python2uml.generateC"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
